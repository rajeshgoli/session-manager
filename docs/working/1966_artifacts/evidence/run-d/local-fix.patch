From 65d6fa8d883dbe392516fe7ef278b646d0d982c9 Mon Sep 17 00:00:00 2001
From: "sm-1966-oc (local agent)" <sm-1966-oc@local.invalid>
Date: Sat, 3 Oct 2026 16:56:47 -0700
Subject: [PATCH] Close inherited listener and socket descriptors in queue job
 children

Queue jobs spawned by the live server inherited its open listener
descriptors: after a blue-green handover the HTTP listener and the
authority and handover sockets arrive through SCM_RIGHTS without
close-on-exec, so every job child (and its test children) held
production sockets. Reuse the tmux pre-exec descriptor sweep for
spawn_queue_job_process and tighten the direct-harness lsof assertion
to fail on inherited sockets.
---
 crates/sm-server/src/http.rs    |  8 ++-
 crates/sm-server/src/queue.rs   | 97 +++++++++++++++++++++++++++++++++
 crates/sm-server/src/runtime.rs |  7 ++-
 3 files changed, 108 insertions(+), 4 deletions(-)

diff --git a/crates/sm-server/src/http.rs b/crates/sm-server/src/http.rs
index 9095c503..a7a7149a 100644
--- a/crates/sm-server/src/http.rs
+++ b/crates/sm-server/src/http.rs
@@ -17460,14 +17460,16 @@ mod tests {
                     first_probe.pid
                 );
                 let open_files = String::from_utf8_lossy(&lsof.stdout);
-                // Queue children may inherit the live authority and handover
-                // sockets. Only regular files and directories can leak state.
+                // A test child must arrive with only the descriptors it opened
+                // itself. An inherited production listener or socket still
+                // reaches live state, and it keeps the old listeners alive
+                // across a server restart (sm#1966).
                 let production_files: Vec<_> = open_files
                     .lines()
                     .skip(1)
                     .filter(|line| {
                         line.contains(production_root.to_string_lossy().as_ref())
-                            && matches!(line.split_whitespace().nth(4), Some("REG" | "DIR"))
+                            || line.contains("(LISTEN)")
                     })
                     .collect();
                 assert!(
diff --git a/crates/sm-server/src/queue.rs b/crates/sm-server/src/queue.rs
index 1d54052b..68c1a764 100644
--- a/crates/sm-server/src/queue.rs
+++ b/crates/sm-server/src/queue.rs
@@ -5390,6 +5390,11 @@ fn spawn_queue_job_process(
     #[cfg(unix)]
     {
         command.process_group(0);
+        // A job only needs its log on stdio. The queue runner's other open
+        // descriptors — the HTTP listener plus the authority and handover
+        // sockets when a blue-green handover passed them without
+        // close-on-exec — would stay alive in every job child (sm#1966).
+        crate::runtime::close_inherited_descriptors_before_exec(&mut command);
         if let Some(ceiling) = process_ceiling {
             // SAFETY: setrlimit(2) is async-signal-safe and touches no parent
             // state. Lowering a limit cannot fail for a value at or below the
@@ -10240,6 +10245,98 @@ mod tests {
         fs::remove_dir_all(job_dir).unwrap();
     }
 
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn queue_job_child_inherits_no_descriptors_above_stdio() {
+        let job_dir = unique_temp_path("inherited-descriptors-spawn");
+        fs::create_dir_all(&job_dir).unwrap();
+        // Mirror a queue runner that received its listeners over SCM_RIGHTS in
+        // a blue-green handover: those descriptors are not marked
+        // close-on-exec, so a bare fork-and-exec hands them to the job and its
+        // test children (sm#1966). A bound unix listener is how the handover
+        // socket and the queue authority socket look in the live runner.
+        let socket_path = job_dir.join("probe.sock");
+        let listener = std::os::unix::net::UnixListener::bind(&socket_path).unwrap();
+        {
+            use std::os::fd::AsRawFd;
+            assert_eq!(
+                unsafe { libc::fcntl(listener.as_raw_fd(), libc::F_SETFD, 0) },
+                0
+            );
+        }
+        let probe_path = job_dir.join("child-fds");
+        let wrapper_path = job_dir.join("run.zsh");
+        let exit_code_path = job_dir.join("exit.code");
+        let log_path = job_dir.join("job.log");
+        // The job's probe lists the shell's own open descriptors while it is
+        // still alive, so the parent reads a snapshot instead of racing a
+        // still-running child.
+        write_queue_job_wrapper(
+            &wrapper_path,
+            "/tmp",
+            Some(&[
+                "/bin/sh".to_owned(),
+                "-c".to_owned(),
+                format!(
+                    "if command -v lsof >/dev/null; then lsof -p $$ > '{}'; else echo no-lsof > '{}'; fi; exit 0",
+                    probe_path.display(),
+                    probe_path.display()
+                ),
+            ]),
+            None,
+            &BTreeMap::new(),
+            &exit_code_path,
+        )
+        .unwrap();
+        let job = QueueJobRuntimeRecord {
+            owner: None,
+            label: "inherited-descriptors".into(),
+            id: "job-inherited-descriptors".to_owned(),
+            job_type: "tests".to_owned(),
+            state: "pending".to_owned(),
+            notify_session_id: None,
+            queued_at: now_rfc3339(),
+            started_at: None,
+            finished_at: None,
+            holding_reason: None,
+            wrapper_path: Some(wrapper_path.display().to_string()),
+            log_path: Some(log_path.display().to_string()),
+            exit_code_path: Some(exit_code_path.display().to_string()),
+            timeout_seconds: 60,
+            max_wait_seconds: DEFAULT_QUEUE_MAX_WAIT_SECONDS,
+            cpu_percent: None,
+            gpu_percent: None,
+            memory_bytes: None,
+            pid: None,
+            process_group_id: None,
+            exit_code: None,
+            completion_notified_at: None,
+            termination_detail_json: None,
+            revived_at: None,
+            process_limit: None,
+            peak_process_count: None,
+            owner_forced_at: None,
+            lane_rank: i64::MAX,
+            rank_tickets: None,
+        };
+
+        let status = spawn_queue_job_process(&job, None).unwrap().wait().unwrap();
+        assert!(
+            status.success(),
+            "{}",
+            fs::read_to_string(&log_path).unwrap()
+        );
+        let child_open_files = fs::read_to_string(&probe_path).unwrap();
+        if child_open_files.trim() == "no-lsof" {
+            return;
+        }
+        assert!(
+            !child_open_files.contains("probe.sock"),
+            "queue job child inherited the runner's descriptors:\n{child_open_files}"
+        );
+        fs::remove_dir_all(job_dir).unwrap();
+    }
+
     #[test]
     fn cancel_in_progress_keeps_precedence_over_memory_guard() {
         let state_dir = unique_temp_path("memory-guard-cancel");
diff --git a/crates/sm-server/src/runtime.rs b/crates/sm-server/src/runtime.rs
index fef4b83c..18f647f1 100644
--- a/crates/sm-server/src/runtime.rs
+++ b/crates/sm-server/src/runtime.rs
@@ -205,7 +205,12 @@ impl std::error::Error for CodexModelValidationError {}
 /// forever and that thread would wait for EOF indefinitely (sm#1432). Close
 /// every inherited non-close-on-exec descriptor above stdio in the child.
 /// Close-on-exec descriptors, including std's exec-error pipe, stay open.
-fn close_inherited_descriptors_before_exec(command: &mut Command) {
+///
+/// Queue jobs need the same guard: after a blue-green handover the HTTP
+/// listener and the authority and handover sockets arrive through SCM_RIGHTS,
+/// which does not mark them close-on-exec, and the queue runner would
+/// otherwise pin them inside every job child (sm#1966).
+pub(crate) fn close_inherited_descriptors_before_exec(command: &mut Command) {
     const MAX_SCANNED_DESCRIPTORS: u64 = 65_536;
     let scan_limit = nix::sys::resource::getrlimit(nix::sys::resource::Resource::RLIMIT_NOFILE)
         .map(|(soft, _)| soft)

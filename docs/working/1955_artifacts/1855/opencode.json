{
  "$schema": "https://opencode.ai/config.json",
  "model": "mtplx/flash",
  "small_model": "mtplx/flash",
  "enabled_providers": [
    "mtplx"
  ],
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "mcp": {},
  "plugin": [],
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "external_directory": "allow"
  },
  "lsp": false,
  "formatter": false,
  "provider": {
    "mtplx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Flash-Next",
      "options": {
        "baseURL": "http://127.0.0.1:1236/v1",
        "apiKey": "local"
      },
      "models": {
        "flash": {
          "name": "Qwen3.8-Flash-Next",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "temperature": 0,
      "topP": 1
    }
  }
}

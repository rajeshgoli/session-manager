         Some(&mut control),
-        MsgFlags::empty(),
+        receive_flags,
     )
     .context("failed to receive handover listeners")?;
     if message.flags.contains(MsgFlags::MSG_CTRUNC) {
@@ -503,6 +510,15 @@ pub fn receive_listeners(stream: &UnixStream) -> Result<(Vec<OwnedFd>, bool)> {

+    #[cfg(unix)]
+    #[test]
+    fn queue_job_child_inherits_nothing_above_standard_descriptors() {
+        // The job child must start with only stdin, stdout and stderr. A
+        // listener or accepted socket can arrive without close-on-exec — a
+        // handover passes descriptors that way — and then every queue job keeps
+        // the live HTTP listener, handover socket and authority socket alive and
+        // hands them to whatever it runs. The duplicated descriptor below stands
+        // in for those, and the wrapper proves with its own log whether the
+        // child could still read it.
+        let job_dir = unique_temp_path("inherited-descriptors");
+        fs::create_dir_all(&job_dir).unwrap();
+        let inherited_path = job_dir.join("inherited-listener");
+        fs::write(&inherited_path, "production-listener\n").unwrap();
+        let inherited = fs::File::open(&inherited_path).unwrap();
+        let inherited_fd = nix::fcntl::fcntl(
+            std::os::fd::AsRawFd::as_raw_fd(&inherited),
+            nix::fcntl::FcntlArg::F_DUPFD(200),
+        )
+        .unwrap();
+        assert_eq!(
+            nix::fcntl::fcntl(inherited_fd, nix::fcntl::FcntlArg::F_GETFD).unwrap()
+                & nix::libc::FD_CLOEXEC,
+            0,
+            "the probe descriptor must start inheritable"
+        );
+
+        let wrapper_path = job_dir.join("run.zsh");
+        let exit_code_path = job_dir.join("exit.code");
+        let log_path = job_dir.join("job.log");
+        let probe = format!(
+            r#"if read -r marker <&{inherited_fd} 2>/dev/null; then echo "inherited: $marker"; else echo 'inherited: none'; fi"#
+        );
+        write_queue_job_wrapper(
+            &wrapper_path,
+            "/tmp",
+            Some(&["/bin/zsh".to_owned(), "-c".to_owned(), probe]),
+            None,
+            &BTreeMap::new(),
+            &exit_code_path,
+        )
+        .unwrap();
+        let job = QueueJobRuntimeRecord {
+            owner: None,
+            label: "descriptor-probe".into(),
+            id: "job-inherited-descriptors".to_owned(),
+            job_type: "tests".to_owned(),
+            state: "pending".to_owned(),
+            notify_session_id: None,
+            queued_at: now_rfc3339(),
+            started_at: None,
+            finished_at: None,
+            holding_reason: None,
+            wrapper_path: Some(wrapper_path.display().to_string()),
+            log_path: Some(log_path.display().to_string()),
+            exit_code_path: Some(exit_code_path.display().to_string()),
+            timeout_seconds: 60,
+            max_wait_seconds: DEFAULT_QUEUE_MAX_WAIT_SECONDS,
+            cpu_percent: None,
+            gpu_percent: None,
+            memory_bytes: None,
+            pid: None,
+            process_group_id: None,
+            exit_code: None,
+            completion_notified_at: None,
+            termination_detail_json: None,
+            revived_at: None,
+            process_limit: None,
+            peak_process_count: None,
+            owner_forced_at: None,
+            lane_rank: i64::MAX,
+            rank_tickets: None,
+        };
+
+        let status = spawn_queue_job_process(&job, None).unwrap().wait().unwrap();
+        let _ = nix::unistd::close(inherited_fd);
+        let log = fs::read_to_string(&log_path).unwrap();
+        assert!(status.success(), "job log: {log}");
+        assert!(
+            !log.contains("production-listener"),
+            "queue job child inherited descriptor {inherited_fd}:\n{log}"
+        );
+        assert!(
+            log.contains("inherited: none"),
+            "job child could not report its descriptors, so the probe proved nothing:\n{log}"
+        );
+
+        fs::remove_dir_all(job_dir).unwrap();
+    }
+
